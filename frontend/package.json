    "@tabler/icons-react": "3.50.0",
    "@tanstack/react-query": "5.106.0",
    "i18next": "26.7.1",
    "motion": "14.9.1",
    "qrcode-generator": "2.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.12",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
