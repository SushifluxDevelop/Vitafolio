* text=auto

# Shell scripts run in Git Bash and inside Linux containers - must keep LF even on a Windows checkout
*.sh text eol=lf
scripts/git-hooks/* text eol=lf

# PowerShell and batch files stay CRLF (Windows PowerShell 5.1)
*.ps1 text eol=crlf
*.cmd text eol=crlf

*.png binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
